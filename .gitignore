# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local tooling (not part of the app)
.claude/

# internal documents — not meant for the public repo
AUDITORIA-*.xlsx
AUDITORIA-*.docx
CATALOGO ARTIGOS.xlsx
PROMPT-*.md
TabelaPreços_ArCondicionado_*
folheto_ar_condicionado_*.pdf
analise-melhorias.js
teka-urls.txt
start-site.bat

# manuais/documentos PDF (3.3GB) — inviável no git, mover para storage
# externo (CDN/bucket) antes de repor os links de download no site
public/documents/

# guarda a API key da Anthropic escrita pelo admin em /admin/chatbot —
# nunca deve ir para o git (usar sempre a env var ANTHROPIC_API_KEY em produção)
src/data/chatbot/ai-config.json
